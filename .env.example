# Copy to .env. Never commit .env.
# Upstox developer app (https://account.upstox.com/developer/apps). Orders must come from the
# static IP registered on that app (SEBI retail algo rules, in force from 1 Apr 2026).
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback
# Optional: tag orders with a registered algo name (needed only above 10 orders per second)
# UPSTOX_ALGO_NAME=
# Where the daily access token is stored (outside the repo by default)
# OPTLAB_TOKEN_FILE=~/.optlab/upstox_token.json
